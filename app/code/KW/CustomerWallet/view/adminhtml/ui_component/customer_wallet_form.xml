<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">customer_wallet_form.customer_wallet_form_data_source</item>
            <item name="deps" xsi:type="string">customer_wallet_form.customer_wallet_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">General Information</item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="namespace" xsi:type="string">customer_wallet_form</item>
        </item>
        <item name="spinner" xsi:type="string">general_information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>

    <settings>
        <buttons>
            <button name="save" class="KW\CustomerWallet\Block\Adminhtml\Wallet\Form\SaveButton" />
            <button name="add-money" class="KW\CustomerWallet\Block\Adminhtml\Wallet\Form\AddMoneyButton" />
            <button name="back" class="KW\CustomerWallet\Block\Adminhtml\Wallet\Form\BackButton" />
        </buttons>
    </settings>

    <!-- Form Data Source -->
    <dataSource name="customer_wallet_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">KW\CustomerWallet\Ui\DataProvider\Wallet\Form\DataProvider
            </argument>
            <argument name="name" xsi:type="string">customer_wallet_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">wallet_id</argument>
            <argument name="requestFieldName" xsi:type="string">wallet_id</argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="*/*/save"/>
        </settings>
    </dataSource>

    <!-- Wallet Information Section -->
    <fieldset name="general_information">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">false</item>
                <item name="label" xsi:type="string" translate="true">Wallet Information</item>
                <item name="sortOrder" xsi:type="number">10</item>
            </item>
        </argument>
        <field name="wallet_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataScope" xsi:type="string">wallet_id</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="disabled" xsi:type="string">true</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="label" xsi:type="string" translate="true">Wallet Id</item>
                    <item name="source" xsi:type="string">wallet_id</item>
                </item>
            </argument>
        </field>
        <field name="public_hash">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataScope" xsi:type="string">public_hash</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="disabled" xsi:type="string">true</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="label" xsi:type="string" translate="true">Wallet Public Identifier</item>
                    <item name="source" xsi:type="string">public_hash</item>
                </item>
            </argument>
        </field>
        <field name="is_active">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataScope" xsi:type="string">is_active</item>
                    <item name="dataType" xsi:type="string">boolean</item>
                    <item name="formElement" xsi:type="string">checkbox</item>
                    <item name="label" xsi:type="string" translate="true">Enable</item>
                    <item name="prefer" xsi:type="string">toggle</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                    <item name="valueMap" xsi:type="array">
                        <item name="true" xsi:type="string">1</item>
                        <item name="false" xsi:type="string">0</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="balance">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataScope" xsi:type="string">balance</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="disabled" xsi:type="string">true</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="label" xsi:type="string" translate="true">Balance</item>
                    <item name="notice" xsi:type="string" translate="true">
                        Cannot modify the balance from here. Use the "Add Money" Button on the top
                    </item>
                </item>
            </argument>
        </field>
    </fieldset>

    <!-- Transaction Listing Section -->
    <fieldset name="transaction_listing">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">true</item>
                <item name="label" xsi:type="string" translate="true">Wallet Transactions</item>
                <item name="sortOrder" xsi:type="number">20</item>
            </item>
        </argument>

        <insertListing name="customer_wallet_transaction_listing" component="Magento_Customer/js/form/components/insert-listing">
            <settings>
                <dataLinks>
                    <exports>false</exports>
                    <imports>true</imports>
                </dataLinks>
                <externalProvider>customer_wallet_transaction_listing.customer_wallet_transaction_listing_data_source</externalProvider>
                <autoRender>true</autoRender>
                <dataScope>customer_wallet_transaction_listing</dataScope>
                <ns>customer_wallet_transaction_listing</ns>
                <exports>
                    <link name="wallet_id">${ $.externalProvider }:params.wallet_id</link>
                </exports>
                <imports>
                    <link name="wallet_id">${ $.provider }:data.wallet_id</link>
                </imports>
            </settings>
        </insertListing>
    </fieldset>

    <!-- Topup Listing Section -->
    <fieldset name="topup_listing">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">true</item>
                <item name="label" xsi:type="string" translate="true">Wallet Topups</item>
                <item name="sortOrder" xsi:type="number">30</item>
            </item>
        </argument>

        <insertListing name="customer_wallet_topup_listing" component="Magento_Customer/js/form/components/insert-listing">
            <settings>
                <dataLinks>
                    <exports>false</exports>
                    <imports>true</imports>
                </dataLinks>
                <externalProvider>customer_wallet_topup_listing.customer_wallet_topup_listing_data_source</externalProvider>
                <autoRender>true</autoRender>
                <dataScope>customer_wallet_topup_listing</dataScope>
                <ns>customer_wallet_topup_listing</ns>
                <exports>
                    <link name="wallet_id">${ $.externalProvider }:params.wallet_id</link>
                </exports>
                <imports>
                    <link name="wallet_id">${ $.provider }:data.wallet_id</link>
                </imports>
            </settings>
        </insertListing>
    </fieldset>

