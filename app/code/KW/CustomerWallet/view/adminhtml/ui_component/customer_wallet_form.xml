<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">customer_wallet_form.customer_wallet_form_data_source</item>
            <item name="deps" xsi:type="string">customer_wallet_form.customer_wallet_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Wallet Information</item>
        <item name="config" xsi:type="array">
            <item name="namespace" xsi:type="string">customer_wallet_form</item>
            <item name="dataScope" xsi:type="string">wallet_id</item> <!-- No prefix -->
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>

    <settings>
        <buttons>
            <button name="addMoney" class="KW\CustomerWallet\Block\Adminhtml\Wallet\Form\AddMoneyButton"/>
            <button name="save" class="KW\CustomerWallet\Block\Adminhtml\Wallet\Form\SaveButton"/>
        </buttons>
        <deps>
            <dep>customer_wallet_form.customer_wallet_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="customer_wallet_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="*/*/save"/>
        </settings>
        <dataProvider class="KW\CustomerWallet\Ui\DataProvider\Wallet\Form\DataProvider"
                      name="customer_wallet_form_data_source">
            <settings>
                <requestFieldName>wallet_id</requestFieldName>
                <primaryFieldName>wallet_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">General</item>
            </item>
        </argument>

        <!-- Wallet ID - disabled, top-level value -->
        <field name="wallet_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Wallet ID</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="dataScope" xsi:type="string">wallet_id</item>
                    <item name="disabled" xsi:type="boolean">true</item>
                </item>
            </argument>
        </field>

        <!-- Status - toggle switch -->
<!--        <field name="is_active">-->
<!--            <argument name="data" xsi:type="array">-->
<!--                <item name="config" xsi:type="array">-->
<!--                    <item name="sortOrder" xsi:type="number">10</item>-->
<!--                    <item name="dataType" xsi:type="string">boolean</item>-->
<!--                    <item name="formElement" xsi:type="string">toggle</item>-->
<!--                    <item name="label" xsi:type="string" translate="true">Enable</item>-->
<!--                    <item name="prefer" xsi:type="string">toggle</item>-->
<!--                    <item name="valueMap" xsi:type="array">-->
<!--                        <item name="true" xsi:type="string">1</item>-->
<!--                        <item name="false" xsi:type="string">0</item>-->
<!--                    </item>-->
<!--                    <item name="default" xsi:type="string">1</item>-->
<!--                </item>-->
<!--            </argument>-->
<!--        </field>-->
    </fieldset>
</form>
