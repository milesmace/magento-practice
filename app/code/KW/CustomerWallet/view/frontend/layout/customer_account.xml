<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer_account_navigation">
            <block class="KW\CustomerWallet\Block\Account\Navigation\WalletLink"
                   name="customer-account-customer-wallet-link">
                <arguments>
                    <argument name="path" xsi:type="string">customer/wallet/index</argument>
                    <argument name="label" xsi:type="string" translate="true">My Wallet</argument>
