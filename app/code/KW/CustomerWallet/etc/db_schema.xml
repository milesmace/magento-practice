<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="customer_wallet" resource="default" engine="innodb" comment="Customer Wallet">
        <column xsi:type="int" name="wallet_id" unsigned="true" nullable="false" identity="true" comment="Wallet ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Wallet Active status"/>
        <column xsi:type="decimal" name="balance" scale="4" precision="12" nullable="false" default="0.0000" comment="Wallet Balance"/>
        <column xsi:type="varchar" length="64" name="public_hash" nullable="false" comment="Public Identification Hash of the wallet"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="wallet_id"/>
        </constraint>

        <constraint xsi:type="unique" referenceId="CUSTOMER_WALLET_CUSTOMER_ID_UNIQUE">
            <column name="customer_id" />
            <column name="public_hash" />
        </constraint>

        <constraint xsi:type="foreign" referenceId="CUSTOMER_WALLET_CUSTOMER_ID_FK" table="customer_wallet" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>

    <table name="wallet_transactions" resource="default" engine="innodb" comment="Wallet Transactions">
        <column xsi:type="int" name="transaction_id" unsigned="true" nullable="false" identity="true" comment="Transaction ID"/>
        <column xsi:type="int" name="wallet_id" unsigned="true" nullable="false" comment="Wallet ID"/>
        <column xsi:type="varchar" length="32" name="tid" unsigned="true" nullable="false" comment="Unique Transaction ID"/>
        <column xsi:type="decimal" name="amount" scale="4" precision="12" nullable="false" comment="Transaction Amount"/>
        <column xsi:type="int" name="related_wallet_id" unsigned="true" nullable="true" comment="Related Wallet ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="true" comment="Order ID"/>
        <column xsi:type="text" name="description" nullable="true" comment="Transaction Description"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="transaction_id"/>
        </constraint>

        <constraint xsi:type="foreign" referenceId="WALLET_TX_WALLET_ID_FK" table="wallet_transactions" column="wallet_id"
                    referenceTable="customer_wallet" referenceColumn="wallet_id" onDelete="CASCADE"/>
    </table>

    <table name="wallet_topups" resource="default" engine="innodb" comment="Wallet Top-ups">
        <column xsi:type="int" name="topup_id" unsigned="true" nullable="false" identity="true" comment="Top-up ID"/>
        <column xsi:type="int" name="wallet_id" unsigned="true" nullable="false" comment="Wallet ID"/>
        <column xsi:type="decimal" name="amount" scale="4" precision="12" nullable="false" comment="Top-up Amount"/>
        <column xsi:type="text" name="note" nullable="true" comment="Admin Note"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="topup_id"/>
        </constraint>

        <constraint xsi:type="foreign" referenceId="WALLET_TOPUP_WALLET_ID_FK" table="wallet_topups" column="wallet_id"
                    referenceTable="customer_wallet" referenceColumn="wallet_id" onDelete="CASCADE"/>
    </table>
</schema>
